NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27017/learnwave_dev
MONGODB_DB_NAME=learnwave_dev

REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_REFRESH_EXPIRY=30d
COOKIE_SECRET=replace-with-a-random-16-plus-character-secret
BCRYPT_COST_FACTOR=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=
