{
  "name": "@learnwave/api",
  "version": "1.0.0",
  "description": "LearnWave backend API — Express + MongoDB + BullMQ + OpenAI",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/server.ts",
    "dev:worker": "tsx watch -r tsconfig-paths/register src/worker-server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.4.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.7.15",
    "cloudinary": "^2.2.0",
    "openai": "^4.47.1",
    "socket.io": "^4.7.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "stripe": "^15.7.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.6",
    "winston": "^3.13.0",
    "express-rate-limit": "^7.2.0",
    "rate-limit-redis": "^4.2.0",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^9.0.1",
    "googleapis": "^137.1.0",
    "google-auth-library": "^9.10.0",
    "@sendgrid/mail": "^8.1.3",
    "axios": "^1.7.2",
    "compression": "^1.7.4",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.7.2",
    "adm-zip": "^0.5.12",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.8",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
